{
    "name": "@base/bot",
    "version": "1.0.0",
    "description": "base",
    "main": "dist/cmd/main.js",
    "module": "main.ts",
    "type": "module",
    "prisma": {
        "schema": "database/schema.prisma"
    },
    "scripts": {
        "start": "bun cmd/main.ts",
        "dev": "bun --watch cmd/main.ts",
        "clean": "rm -rf dist",
        "test": "bun test",
        "lint": "bunx eslint . --ext .ts",
        "format": "bunx prettier --write .",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset"
    },
    "dependencies": {
        "@prisma/client": "^6.0.0",
        "dotenv": "^17.3.1",
        "redis": "^5.11.0"
    },
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "bun": "^1.3.9",
        "prisma": "^6.0.0",
        "typescript": "^5.9.3"
    },
    "private": true
}