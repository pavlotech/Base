import { ISceneDeps } from "@core/interfaces/deps.interface";
import { SceneOptions } from "@core/interfaces/scene.interface";
import { ConfigType } from "@core/interfaces/config.interface";

export default class Scene {
    public readonly name: string;
    private buildFn: (deps: ISceneDeps, config: ConfigType) => Promise<void>;
    private deps?: ISceneDeps;
    private config?: ConfigType;

    constructor(
        private readonly options: SceneOptions,
        buildFn: (deps: ISceneDeps, config: ConfigType) => Promise<void>,
    ) {
        this.name = options.name;
        this.buildFn = buildFn;
    }

    public setDeps(deps: ISceneDeps) {
        this.deps = deps;
    }

    public setConfig(config: ConfigType) {
        this.config = config;
    }

    public async init() {
        if (!this.deps) {
            throw new Error("Dependencies not installed");
        }
        await this.buildFn(this.deps, this.config as ConfigType);
    }
}
