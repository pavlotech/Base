// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./data.db"
}

model User {
    id                String         @id
    role              String         @default("USER")
    blocked           Boolean        @default(false)
    steamId           String?
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt

    @@map("users")
}

model Guild {
    id          String   @id
    allowedCmds String   @default("ping,setup")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("guilds")
}

model Message {
    id        String   @id @default(uuid())
    contextId String
    role      String
    content   String
    createdAt DateTime @default(now())

    @@map("chat_messages")
}

model CachedContext {
    id         String   @id @default(uuid())
    contextId  String   @unique
    cacheName  String
    messageCount Int
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("cached_contexts")
}